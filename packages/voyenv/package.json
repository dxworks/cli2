{
  "name": "@dxworks/voyenv",
  "version": "0.4.0",
  "description": "A cli utility to create voyager releases",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "voyenv": "dist/index.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@cli-new/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "keywords": [
    "cli",
    "voyager"
  ],
  "author": "Mario Rivis <mario.rivis@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxworks/cli.git"
  },
  "homepage": "https://github.com/dxworks/cli#readme",
  "bugs": {
    "url": "https://github.com/dxworks/cli/issues"
  },
  "dependencies": {
    "@dxworks/common": "workspace:*",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.2",
    "octokit": "^5.0.5",
    "semver": "^7.7.3",
    "string-template": "^1.0.0",
    "tslib": "^2.3.0",
    "yaml": "^2.8.1"
  },
  "scripts": {
    "postbuild": "copyfiles -u 1 \"src/assets/**/*\" dist"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/semver": "^7.7.1",
    "@types/string-template": "^1.0.7",
    "copyfiles": "^2.4.1"
  }
}
