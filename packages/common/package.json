{
  "name": "@dxworks/common",
  "version": "0.0.2",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@cli-new/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./src/*": {
      "@cli-new/source": "./src/*",
      "default": "./dist/*"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "axios": "^1.14.0",
    "cli-progress": "^3.12.0",
    "isomorphic-git": "^1.34.2",
    "octokit": "^5.0.5",
    "tslib": "^2.3.0",
    "unzipper": "^0.12.3",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "24.10.0",
    "@types/unzipper": "^0.10.11",
    "archiver": "^7.0.1"
  }
}
